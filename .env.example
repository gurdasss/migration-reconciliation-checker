# Copy this file to .env and fill in real values. .env is gitignored.
# These are the credentials the Postgres containers are created with, so
# changing them later needs: docker compose down -v && docker compose up -d
DB_USER=your_database_username
DB_PASSWORD=your_database_password

# Everything below is optional. The defaults point at the two local Docker
# containers, so leave them unset for local work. They exist so the same code
# can run against RDS without being edited -- in AWS, set them on the
# function's environment instead of in a file.
#
# SOURCE_HOST=localhost
# SOURCE_PORT=5433
# SOURCE_DB=source
# TARGET_HOST=localhost
# TARGET_PORT=5434
# TARGET_DB=target
#
# BATCH_SIZE=10000            # rows fetched per round trip
# DB_CONNECT_TIMEOUT=10       # seconds before giving up on a connection
